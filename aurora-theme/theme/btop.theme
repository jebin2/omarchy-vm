# Aurora. main_bg is intentionally empty so btop inherits the terminal's
# background -- with foot at alpha 0.86 that makes btop glass too.
theme[main_bg]=""
theme[main_fg]="#c8d3f5"
theme[title]="#e6ecff"
theme[hi_fg]="#7dcfff"
theme[selected_bg]="#252c47"
theme[selected_fg]="#e6ecff"
theme[inactive_fg]="#3a4260"
theme[graph_text]="#5a6591"
theme[meter_bg]="#161a2b"
theme[proc_misc]="#56e0b0"

# One quiet border colour for every box -- the stock template gives each box a
# different hue, which fights the wallpaper.
theme[cpu_box]="#2a3350"
theme[mem_box]="#2a3350"
theme[net_box]="#2a3350"
theme[proc_box]="#2a3350"
theme[div_line]="#232a44"

theme[temp_start]="#7dcfff"
theme[temp_mid]="#ffd479"
theme[temp_end]="#ff6b81"

theme[cpu_start]="#56e0b0"
theme[cpu_mid]="#7dcfff"
theme[cpu_end]="#bb9af7"

theme[free_start]="#7dcfff"
theme[free_mid]="#6f9cff"
theme[free_end]="#bb9af7"

theme[cached_start]="#6f9cff"
theme[cached_mid]="#7dcfff"
theme[cached_end]="#9fdcff"

theme[available_start]="#bb9af7"
theme[available_mid]="#6f9cff"
theme[available_end]="#7dcfff"

theme[used_start]="#56e0b0"
theme[used_mid]="#ffd479"
theme[used_end]="#ff6b81"

theme[download_start]="#7dcfff"
theme[download_mid]="#6f9cff"
theme[download_end]="#bb9af7"

theme[upload_start]="#56e0b0"
theme[upload_mid]="#7dcfff"
theme[upload_end]="#bb9af7"

theme[process_start]="#7dcfff"
theme[process_mid]="#bb9af7"
theme[process_end]="#ff6b81"

theme[gradient_color_0]="#0d0f1a"
theme[gradient_color_1]="#161a2b"
theme[gradient_color_2]="#252c47"
theme[gradient_color_3]="#3a4260"
theme[gradient_color_4]="#6f9cff"
theme[gradient_color_5]="#7dcfff"
theme[gradient_color_6]="#bb9af7"
theme[gradient_color_7]="#e6ecff"
