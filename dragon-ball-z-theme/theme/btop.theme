# Dragon Ball Z. main_bg is intentionally empty so btop inherits the terminal's
# background -- with foot at alpha 0.86 that makes btop glass too.
theme[main_bg]=""
theme[main_fg]="#ede4d6"
theme[title]="#fff8ec"
theme[hi_fg]="#ff7a1a"
theme[selected_bg]="#3d2f22"
theme[selected_fg]="#fff8ec"
theme[inactive_fg]="#4a3f36"
theme[graph_text]="#8a7868"
theme[meter_bg]="#231c17"
theme[proc_misc]="#ffc93c"

# One quiet border colour for every box; the stock template gives each box a
# different hue, which fights the wallpaper.
theme[cpu_box]="#4a382a"
theme[mem_box]="#4a382a"
theme[net_box]="#4a382a"
theme[proc_box]="#4a382a"
theme[div_line]="#33281f"

# Power level rising: gold -> orange -> Kaio-ken red.
theme[temp_start]="#ffc93c"
theme[temp_mid]="#ff7a1a"
theme[temp_end]="#e8503c"

theme[cpu_start]="#ffc93c"
theme[cpu_mid]="#ff7a1a"
theme[cpu_end]="#e8503c"

theme[free_start]="#4fb8ff"
theme[free_mid]="#4a90e2"
theme[free_end]="#b07ae0"

theme[cached_start]="#4a90e2"
theme[cached_mid]="#4fb8ff"
theme[cached_end]="#7fceff"

theme[available_start]="#7ec850"
theme[available_mid]="#4fb8ff"
theme[available_end]="#4a90e2"

theme[used_start]="#ffc93c"
theme[used_mid]="#ff7a1a"
theme[used_end]="#e8503c"

theme[download_start]="#4fb8ff"
theme[download_mid]="#4a90e2"
theme[download_end]="#b07ae0"

theme[upload_start]="#ffc93c"
theme[upload_mid]="#ff7a1a"
theme[upload_end]="#e8503c"

theme[process_start]="#ffc93c"
theme[process_mid]="#ff7a1a"
theme[process_end]="#e8503c"

theme[gradient_color_0]="#171310"
theme[gradient_color_1]="#231c17"
theme[gradient_color_2]="#3d2f22"
theme[gradient_color_3]="#8a5a33"
theme[gradient_color_4]="#e8503c"
theme[gradient_color_5]="#ff7a1a"
theme[gradient_color_6]="#ffc93c"
theme[gradient_color_7]="#fff8ec"
