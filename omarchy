#!/usr/bin/env bash
# ==============================================================================
# Omarchy Linux VM — install, open, stop, reset, delete
# ==============================================================================
set -euo pipefail

# Resolve symlinks (e.g. ~/.local/bin/omarchy) so lib/ is found next to the real script.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/detect.sh"
source "$SCRIPT_DIR/lib/vm.sh"
source "$SCRIPT_DIR/lib/autoinstall.sh"

vm_defined() {
  virsh -c "$URI" dominfo "$DOMAIN" >/dev/null 2>&1
}

# Ask before destroying the VM; -y skips. Returns 1 when the user declines.
confirm_wipe() {
  local action="$1" yes="$2" ans
  [ "$yes" -eq 1 ] && return 0
  echo -e "${RED}WARNING:${NC} $action permanently deletes the Omarchy VM and everything in it ($DISK)."
  read -r -p "Continue? [y/N]: " ans
  [[ "$ans" =~ ^[Yy] ]]
}

# Parse [ISO] [--manual] [-y] shared by install and reset.
INSTALL_ISO="" INSTALL_MANUAL=0 INSTALL_YES=0
parse_install_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --manual) INSTALL_MANUAL=1 ;;
      -y|--yes) INSTALL_YES=1 ;;
      *.iso)
        [ -f "$1" ] || die "ISO not found: $1"
        INSTALL_ISO="$1" ;;
      *) die "Unknown option: $1 (see: omarchy help)" ;;
    esac
    shift
  done
}

cmd_install() {
  if vm_exists; then
    die "An Omarchy VM already exists. Open it with 'omarchy open', or reinstall with 'omarchy reset'."
  fi

  echo -e "\n${BOLD}================================================================${NC}"
  echo -e "${BOLD}              Omarchy Linux VM — Install                        ${NC}"
  echo -e "${BOLD}================================================================${NC}\n"

  detect_dependencies
  detect_kvm
  detect_ovmf
  detect_gpu
  detect_ssh_key
  detect_iso "$INSTALL_ISO"

  AUTO_MODE=0
  if [ "$INSTALL_MANUAL" -eq 0 ]; then
    detect_autoinstall_deps
    auto_prompt_credentials
    AUTO_MODE=1
  fi

  vm_create_disk
  CIDATA=""
  if [ "$AUTO_MODE" -eq 1 ]; then
    auto_build_cidata
    CIDATA="$CIDATA_ISO"
  fi
  vm_synthesize_xml
  vm_define
  vm_install_desktop_entry
  run_provisioner
}

cmd_reset() {
  vm_exists || { say "No existing VM; installing fresh."; cmd_install; return; }
  confirm_wipe "Reset" "$INSTALL_YES" || { echo "Reset cancelled."; return 0; }
  vm_purge
  cmd_install
}

cmd_delete() {
  local yes=0
  case "${1:-}" in -y|--yes) yes=1 ;; "") ;; *) die "Unknown option: $1" ;; esac
  vm_exists || { say "No Omarchy VM to delete."; return 0; }
  confirm_wipe "Delete" "$yes" || { echo "Delete cancelled."; return 0; }
  vm_purge
  vm_remove_desktop_entry
  ok "Omarchy VM deleted. Downloaded ISOs in $ROOT_DIR were kept (reinstall with: omarchy install)."
}

cmd_open() {
  vm_defined || die "No Omarchy VM yet. Create one with: omarchy install"
  vm_start
  vm_open_viewer
}

# Globals so the EXIT trap can still see them after run_provisioner returns.
PROV_PID=""
SERVE_DIR=""
cleanup_provisioner() {
  [ -n "$PROV_PID" ] && kill "$PROV_PID" 2>/dev/null || true
  [ -n "$SERVE_DIR" ] && rm -rf "$SERVE_DIR" || true
}

run_provisioner() {
  say "Preparing provisioning assets..."

  # Stop any previous instance of our own provisioner
  pkill -f "provisioner.py.*$PROVISION_PORT" 2>/dev/null || true
  sleep 0.5

  # Check if port is already occupied by an unrelated service
  if python3 -c "import socket, sys; s = socket.socket(socket.AF_INET, socket.SOCK_STREAM); sys.exit(0 if s.connect_ex(('127.0.0.1', int(sys.argv[1]))) == 0 else 1)" "$PROVISION_PORT" 2>/dev/null; then
    die "Port $PROVISION_PORT is already in use by another service. Specify a free port with OMARCHY_PROVISION_PORT=<port>."
  fi

  SERVE_DIR="$(mktemp -d)"
  trap cleanup_provisioner EXIT
  # Bake the actual provisioning port into the served guest script.
  sed "s#10\.0\.2\.2:8765#10.0.2.2:$PROVISION_PORT#g" "$GUEST_DIR/setup.sh" > "$SERVE_DIR/setup.sh"
  cp "$PUBKEY" "$SERVE_DIR/authorized_key"
  cp "$GUEST_DIR/clipboard-bridge" "$GUEST_DIR/clipboard-bridge.service" "$SERVE_DIR/"

  say "Starting provisioning server on 127.0.0.1:$PROVISION_PORT..."
  python3 "$LIB_DIR/provisioner.py" "$PROVISION_PORT" "$SERVE_DIR" "$GUEST_USER_FILE" &
  PROV_PID=$!

  sleep 1
  kill -0 "$PROV_PID" 2>/dev/null || die "Could not bind provisioning server on port $PROVISION_PORT"

  vm_start
  vm_open_viewer

  if [ "${AUTO_MODE:-0}" -eq 1 ] && ! auto_install_and_provision; then
    warn "Hands-free setup did not finish; falling back to the manual steps below"
    warn "(skip any step the VM has already completed)."
    AUTO_MODE=0
  fi

  if [ "${AUTO_MODE:-0}" -eq 0 ]; then
    echo -e "\n${BOLD}${GREEN}================================================================${NC}"
    echo -e "${BOLD}${GREEN}               VM Booted & Installer Launched!                  ${NC}"
    echo -e "${BOLD}${GREEN}================================================================${NC}\n"
    echo -e "${BOLD}Next Steps in the VM Window:${NC}"
    echo -e "  ${BOLD}1.${NC} Follow the Omarchy on-screen installer."
    echo -e "  ${BOLD}2.${NC} When installation completes, reboot into the installed system."
    echo -e "  ${BOLD}3.${NC} Open a terminal in Omarchy (${BOLD}Super + Enter${NC} or launch foot) and run:"
    echo -e "\n      ${BOLD}${YELLOW}bash <(curl -fsSL http://10.0.2.2:$PROVISION_PORT)${NC}\n"
    echo -e "  The host is waiting for this signal in the background...\n"
  fi

  local timeout="$PROVISION_TIMEOUT"
  local deadline=$(( $(date +%s) + timeout ))
  local provisioned=0 user=""

  say "Waiting for guest provisioning signal (timeout: $((timeout / 60)) min, press Ctrl+C to cancel)..."
  while true; do
    if [ -f "$GUEST_USER_FILE" ]; then
      user="$(tr -d '[:space:]' < "$GUEST_USER_FILE")"
      echo -e "\n${GREEN}[omarchy] Guest reported completion as user: ${BOLD}$user${NC}!"
      provisioned=1
      break
    fi

    if [ "$(date +%s)" -ge "$deadline" ]; then
      warn "Timed out waiting for guest setup callback after $((timeout / 60)) minutes."
      warn "Start over with: omarchy reset"
      break
    fi
    sleep 3
  done

  if [ "$provisioned" -eq 1 ]; then
    # The installer media is never needed again (manual installs still have it).
    vm_eject_iso
    # Subshell: vm_fit_resolution exits via die on failure.
    ( vm_fit_resolution --wait ) || warn "Could not match the guest screen to the host; reopen with: omarchy open"

    echo -e "\n${BOLD}${GREEN}================================================================${NC}"
    echo -e "${BOLD}${GREEN}               Omarchy VM Ready!                                ${NC}"
    echo -e "${BOLD}${GREEN}================================================================${NC}\n"
    echo -e "  • ${BOLD}Open:${NC}    omarchy open   (or launch 'Omarchy VM' from your app menu)"
    echo -e "  • ${BOLD}Stop:${NC}    omarchy stop"
    echo -e "  • ${BOLD}SSH:${NC}     ssh -p $SSH_PORT $user@127.0.0.1\n"
  fi
}

show_usage() {
  cat <<EOF
Usage: omarchy <command>

Commands:
  install [ISO]   Create the VM and install Omarchy hands-free. Downloads the
                  latest Omarchy ISO unless you pass one.
  open            Start the VM (if needed) and open its window
  stop            Shut the VM down cleanly
  reset [ISO]     Erase the VM and install Omarchy again from scratch
  delete          Erase the VM completely

Options:
  --manual        (install/reset) Use the interactive Omarchy installer instead
  -y              (reset/delete) Skip the confirmation prompt

Environment:
  OMARCHY_ENCRYPT=1   Encrypted disk; unlock it in the VM window at each boot
EOF
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  install)
    parse_install_args "$@"
    cmd_install
    ;;
  reset)
    parse_install_args "$@"
    cmd_reset
    ;;
  delete)
    cmd_delete "$@"
    ;;
  open)
    cmd_open
    ;;
  stop)
    vm_stop
    ;;
  fit)
    # Internal: background screen fit scheduled by 'open'.
    vm_fit_resolution "$@"
    ;;
  help|-h|--help|"")
    show_usage
    ;;
  *)
    show_usage
    die "Unknown command: $cmd"
    ;;
esac
